# ─── Ru'ya Studio — Cloudflare Workers Environment Variables ─────────────────
#
# Environment Configuration for Cloudflare Workers & Production Deployment
# Copy this file to .env or .dev.vars for local testing.
# NEVER commit real secret keys to git.
# ─────────────────────────────────────────────────────────────────────────────

# Public Site Configuration
PUBLIC_SITE_URL=https://ruya.studio
CONTACT_EMAIL=ruya.connect@gmail.com

# Cloudflare Worker Secret (Set via: npx wrangler secret put EMAIL_PROVIDER_API_KEY)
EMAIL_PROVIDER_API_KEY=your_resend_api_key_here
